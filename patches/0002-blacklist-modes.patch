+    def get_local_blacklist(self):
+        """Fill the filter from a plain newline-separated domain list (patched)."""
+        try:
+            with open(self.blacklist_file, encoding='utf-8', errors='ignore') as fh:
+                for line in fh:
+                    line = line.strip()
+                    if line and not line.startswith('#'):
+                        self.blacklist_domains.add(line)
+        except OSError as e:
+            warn.warn('Local blacklist %s is unreadable (%s); running without a filter.'
+                      % (self.blacklist_file, e))
+            return
+        if not self.blacklist_domains:
+            warn.warn('Local blacklist %s is empty; running without a filter.' % self.blacklist_file)
+
